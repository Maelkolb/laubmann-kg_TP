# =============================================================
# Hand-written illustration of the 0.4.0 data shape (one entry):
# archival units -> entry -> records (observations, travel, weather)
# -> details (vocalisations, legs); shared taxa/places/persons/habitat.
# =============================================================

# --- ARCHIVAL UNITS ------------------------------------------

data:volume_unknown a lkg:DiaryVolume ;
    rdfs:label "Band unbekannt"@de .

data:page_19250529 a lkg:DiaryPage ;
    rdfs:label "Vol. ?? (p_19250529)" ;
    dcterms:identifier "p_19250529" ;
    dcterms:isPartOf data:volume_unknown .

data:region_19250529 a lkg:SourceRegion ;
    rdfs:label "Region r_19250529" ;
    dcterms:isPartOf data:page_19250529 .

# --- DIARY ENTRY (the event) ---------------------------------

data:entry_19250529 a lkg:DiaryEntry ;
    rdfs:label "Tagebucheintrag 29. Mai 1925 – München/Gossenzugen"@de ;
    dwc:eventDate "1925-05-29"^^xsd:date ;
    dwc:verbatimEventDate "29. Mai 1925" ;
    dwc:fieldNotes "29. Mai 1925. München - Gossenzugen. Wir fahren über Augsburg - Ulm - Zwiefaltendorf, wo wir um 12 h Nachts ankommen..." ;
    lkg:entryKind "field-day" ;
    lkg:entryPlace data:place_Munich ;
    lkg:datePlausible true ;
    dcterms:isPartOf data:page_19250529 ;
    lkg:hasSourceRegion data:region_19250529 ;
    lkg:mentionsPerson data:person_Kiefer ;
    lkg:mentionsCompanion data:person_Kiefer ;
    lkg:hasWeather data:weather_19250529 ;
    lkg:containsTravelEvent data:journey_19250529 ;
    lkg:containsObservation
        data:obs_Kiebitz_Mering,
        data:obs_Moewe_Lech,
        data:obs_Heuschreckensaenger,
        data:obs_Wachtelkoenig,
        data:obs_Waldohreule,
        data:obs_Storch_Kirchturm .

# --- WEATHER (entry record) ----------------------------------

data:weather_19250529 a lkg:WeatherReport ;
    rdfs:label "Wetter 1925-05-29"@de ;
    lkg:weatherVerbatim "abends kühl, klarer Himmel"@de ;
    lkg:skyCondition "clear" ;
    dcterms:isPartOf data:entry_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 .

# --- TRAVEL (entry record + legs) ----------------------------

data:journey_19250529 a lkg:TravelEvent ;
    rdfs:label "Reise München – Gossenzugen, 29. Mai 1925"@de ;
    dcterms:isPartOf data:entry_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 ;
    lkg:hasLeg data:leg_train_Munich_Zwiefaltendorf,
               data:leg_walk_Zwiefaltendorf_Gossenzugen .

data:leg_train_Munich_Zwiefaltendorf a lkg:TravelLeg ;
    rdfs:label "Zugfahrt München – Zwiefaltendorf"@de ;
    dcterms:isPartOf data:journey_19250529 ;
    lkg:transportMode "train" ;
    lkg:departurePlace data:place_Munich ;
    lkg:arrivalPlace   data:place_Zwiefaltendorf ;
    lkg:departureTime  "1925-05-29T17:00:00"^^xsd:dateTime ;
    lkg:arrivalTime    "1925-05-30T00:00:00"^^xsd:dateTime ;
    lkg:viaPlace data:place_Augsburg, data:place_Ulm .

data:leg_walk_Zwiefaltendorf_Gossenzugen a lkg:TravelLeg ;
    rdfs:label "Fußmarsch Zwiefaltendorf – Gossenzugen"@de ;
    dcterms:isPartOf data:journey_19250529 ;
    lkg:transportMode "foot" ;
    lkg:departurePlace data:place_Zwiefaltendorf ;
    lkg:arrivalPlace   data:place_Gossenzugen ;
    lkg:departureTime  "1925-05-30T00:00:00"^^xsd:dateTime ;
    lkg:arrivalTime    "1925-05-30T01:15:00"^^xsd:dateTime ;
    lkg:viaPlace data:place_Baach, data:place_Zwiefaltenkloster .

# --- TAXA (shared referents; DwC terms only) -----------------

