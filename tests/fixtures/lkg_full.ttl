# =============================================================
# OBSERVATIONS (entry records, dwc:Occurrence)
# every record: eventDate (own date, else the entry's interval),
# recordType, basisOfRecord, occurrenceStatus
# =============================================================

# --- OBS 1: Kiebitz bei Mering (train, visual; own date) ---
data:obs_Kiebitz_Mering a lkg:Observation ;
    rdfs:label "Beobachtung Kiebitz"@de ;
    lkg:observedTaxon    data:taxon_Kiebitz ;
    dcterms:isPartOf     data:entry_19250529 ;
    prov:wasDerivedFrom  data:entry_19250529 ;
    lkg:observedAt       data:place_Mering ;
    lkg:hasLocality      data:place_Mering ;
    dwc:verbatimLocality "Felder nach Station Mering" ;
    dwc:eventDate        "1925-05-29"^^xsd:date ;
    lkg:timeOfDay        "evening" ;
    dwc:occurrenceStatus "present" ;
    lkg:countQualifier   "plural-unspecified" ;
    lkg:verbatimNotes    "einige Kiebitze auf den Feldern"@de ;
    lkg:evidenceKind     "visual" ;
    lkg:spatialContext   "vom Zug aus"@de ;
    lkg:recordType       "field-observation" ;
    dwc:basisOfRecord    "HumanObservation" ;
    dwciri:recordedBy    data:person_c6b2ff6250e5 .

