@prefix data:     <https://w3id.org/laubmann-kg/data/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix dwc:      <http://rs.tdwg.org/dwc/terms/> .
@prefix dwciri:   <http://rs.tdwg.org/dwc/iri/> .
@prefix gbif:     <https://www.gbif.org/species/> .
@prefix geo:      <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix geonames: <https://sws.geonames.org/> .
@prefix gsp:      <http://www.opengis.net/ont/geosparql#> .
@prefix lkg:      <https://w3id.org/laubmann-kg/ontology#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:   <https://schema.org/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix wd:       <http://www.wikidata.org/entity/> .
@prefix gnd:      <https://d-nb.info/gnd/> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# =============================================================
# Hand-written illustration of the 0.7.0 data shape (one entry):
# archival units (volume, pages, text regions, a multimodal region)
# -> entry -> records (observations, travel event + legs, weather);
# shared taxa/places/persons/habitat, each linked to its authority
# (GBIF, GeoNames, Wikidata, GND) with the one SKOS link pattern.
# 0.7.0: the entry runs over two days (eventDate interval); every
# record carries its own date or the entry's interval; the wording
# of a place name stays on the entry / observation (dwc:verbatimLocality),
# the shared Place carries names and a gsp:Geometry point; a companion
# who observed with the diarist is a second dwciri:recordedBy.
# =============================================================

# --- ARCHIVAL UNITS ------------------------------------------

data:volume_unknown a lkg:DiaryVolume ;
    rdfs:label "Band unbekannt"@de .

data:page_19250529 a lkg:DiaryPage ;
    rdfs:label "Vol. ?? (p_19250529)" ;
    dcterms:identifier "p_19250529" ;
    dcterms:isPartOf data:volume_unknown .

data:page_19250530 a lkg:DiaryPage ;
    rdfs:label "Vol. ?? (p_19250530)" ;
    dcterms:identifier "p_19250530" ;
    dcterms:isPartOf data:volume_unknown .

data:region_19250529 a lkg:SourceRegion ;
    rdfs:label "Region r_19250529" ;
    dcterms:isPartOf data:page_19250529 .

# the entry continues on the next page: a second body-text region
data:region_19250530 a lkg:SourceRegion ;
    rdfs:label "Region r_19250530" ;
    dcterms:isPartOf data:page_19250530 .

# a sketch map pasted next to the entry (multimodal catalogue)
data:region_map_19250530 a lkg:MultimodalRegion ;
    rdfs:label "Karte · Bd. ??, Scan 0031"@de ;
    lkg:regionKind "map" ;
    schema:image <https://images.example.org/laubmann/regions/p_19250530/r04_ImageRegion.png> ;
    dcterms:type dcmitype:StillImage ;
    dcterms:description "A hand-drawn map of the Aach valley between Zwiefaltendorf and Gossenzugen with the route in red."@en ;
    lkg:visibleText "Zwiefaltendorf – Baach – Gossenzugen"@de ;
    dcterms:identifier "regions/p_19250530/r04_ImageRegion.png" ;
    dcterms:isPartOf data:page_19250530 .

# --- DIARY ENTRY (the event) ---------------------------------

data:entry_19250529 a lkg:DiaryEntry ;
    rdfs:label "Tagebucheintrag 29. Mai 1925 · München"@de ;
    dwc:eventDate "1925-05-29/1925-05-30" ;                  # multi-day entry: DwC interval
    dwc:verbatimEventDate "29. Mai 1925" ;
    dwc:verbatimLocality "München - Gossenzugen" ;           # the header wording as written
    dwc:fieldNotes "29. Mai 1925. München - Gossenzugen. Wir fahren über Augsburg - Ulm - Zwiefaltendorf, wo wir um 12 h Nachts ankommen..."@de ;
    lkg:entryKind "field-day" ;
    lkg:entryPlace data:place_Munich ;
    lkg:datePlausible true ;
    dcterms:isPartOf data:page_19250529 ;
    lkg:hasSourceRegion data:region_19250529 , data:region_19250530 , data:region_map_19250530 ;
    lkg:hasMultimodalRegion data:region_map_19250530 ;
    lkg:mentionsPerson data:person_Kiefer ;
    lkg:mentionsCompanion data:person_Kiefer ;
    lkg:hasWeather data:weather_19250529 ;
    lkg:containsTravelEvent data:journey_19250529 ;
    lkg:containsObservation
        data:obs_Kiebitz_Mering,
        data:obs_Moewe_Lech,
        data:obs_Heuschreckensaenger,
        data:obs_Wachtelkoenig,
        data:obs_Waldohreule,
        data:obs_Storch_Kirchturm .

# --- WEATHER (entry record; at most one per entry) -----------

data:weather_19250529 a lkg:WeatherReport ;
    rdfs:label "Wetter 1925-05-29"@de ;
    lkg:weatherVerbatim "abends kühl, klarer Himmel"@de ;
    lkg:skyCondition "clear" ;
    dcterms:isPartOf data:entry_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 .

# --- TRAVEL (entry record + legs) ----------------------------

data:journey_19250529 a lkg:TravelEvent ;
    rdfs:label "Reise München – Gossenzugen, 29. Mai 1925"@de ;
    dcterms:isPartOf data:entry_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 ;
    lkg:hasLeg data:leg_train_Munich_Zwiefaltendorf,
               data:leg_walk_Zwiefaltendorf_Gossenzugen .

data:leg_train_Munich_Zwiefaltendorf a lkg:TravelLeg ;
    rdfs:label "Zugfahrt München – Zwiefaltendorf"@de ;
    dcterms:isPartOf data:journey_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 ;
    lkg:transportMode "train" ;
    lkg:departurePlace data:place_Munich ;
    lkg:arrivalPlace   data:place_Zwiefaltendorf ;
    lkg:departureTime  "1925-05-29T17:00:00"^^xsd:dateTime ;
    lkg:arrivalTime    "1925-05-30T00:00:00"^^xsd:dateTime ;
    lkg:viaPlace data:place_Augsburg, data:place_Ulm .

# (lkg:transportMode is optional since 0.7.0: a leg whose mode the text does
# not state carries none — no "unknown" placeholder)
data:leg_walk_Zwiefaltendorf_Gossenzugen a lkg:TravelLeg ;
    rdfs:label "Fußmarsch Zwiefaltendorf – Gossenzugen"@de ;
    dcterms:isPartOf data:journey_19250529 ;
    prov:wasDerivedFrom data:entry_19250529 ;
    lkg:transportMode "foot" ;
    lkg:departurePlace data:place_Zwiefaltendorf ;
    lkg:arrivalPlace   data:place_Gossenzugen ;
    lkg:departureTime  "1925-05-30T00:00:00"^^xsd:dateTime ;
    lkg:arrivalTime    "1925-05-30T01:15:00"^^xsd:dateTime ;
    lkg:viaPlace data:place_Baach, data:place_Zwiefaltenkloster .

# --- TAXA (shared referents; DwC terms only) -----------------

data:taxon_Kiebitz a lkg:Taxon ;
