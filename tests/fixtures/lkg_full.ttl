    skos:exactMatch geonames:2867714\/ , wd:Q1726 ;
    geo:lat 48.1374 ; geo:long 11.5755 ;
    dwc:decimalLatitude 48.1374 ; dwc:decimalLongitude 11.5755 ; dwc:geodeticDatum "WGS84" ;
    dwc:coordinateUncertaintyInMeters 10000 ;
    dwc:georeferenceSources "GeoNames name match (unique in the home region)" ;
    dwc:minimumElevationInMeters 519.0 ; dwc:maximumElevationInMeters 519.0 ;
    gsp:hasGeometry data:geometry_place_Munich .

data:geometry_place_Munich a gsp:Geometry ;
    gsp:asWKT "POINT(11.5755 48.1374)"^^gsp:wktLiteral .

