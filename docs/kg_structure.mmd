%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#F7F8F4", "primaryBorderColor": "#7E8C82", "primaryTextColor": "#1D2A21", "lineColor": "#5F6E64", "clusterBkg": "#EEF1EA", "clusterBorder": "#C9D2C7", "fontFamily": "Segoe UI, system-ui, sans-serif", "fontSize": "14px"}}}%%
classDiagram
    direction TB

    class ArchivalUnit {
        <<abstract · rico:RecordResource>>
    }
    class EntryRecord {
        <<abstract · prov:Entity>>
        prov:wasDerivedFrom → entry
        dcterms:isPartOf → entry (leg → travel event)
    }

    class DiaryVolume {
        <<rico:Record>>
        dcterms:temporal YYYY-MM/YYYY-MM
    }
    class DiaryPage {
        <<rico:RecordPart>>
        dcterms:identifier
    }
    class DiaryEntry {
        <<dwc:Event · rico:RecordPart>>
        dwc:eventDate · dwc:verbatimEventDate
        dwc:verbatimLocality (header wording)
        dwc:fieldNotes
        entryKind · datePlausible · skos:note
    }
    class SourceRegion {
        <<rico:RecordPart>>
        body-text region(s) of the entry
    }
    class MultimodalRegion {
        regionKind drawing | photograph | map | print | object | text-insert | list
        dcterms:type · dcterms:description
        visibleText · dcterms:identifier (crop) · schema:image (URL, once hosted)
    }

    class Observation {
        <<dwc:Occurrence>>
        verbatimNotes
        recordType field-observation | third-party-report | literature-record
        dwc:basisOfRecord · dwc:associatedReferences
        dwc:occurrenceStatus present | absent
        dwc:individualCount ≥0 · individualCountMin · Max
        countQualifier exact | minimum | maximum | approximate | plural-unspecified
        dwc:sex · dwc:lifeStage · dwc:vitality dead
        breedingEvidence · dwc:reproductiveCondition (confirmed)
        movementKind · flightDirection
        evidenceKind visual | auditory | nest | specimen
        callType song | call | alarm | drumming · callTranscription
        dwc:behavior · dwc:habitat
        dwc:identificationQualifier · dwc:verbatimIdentification
        dwc:eventDate (own date or range, else entry date or interval)
        dwc:eventTime · timeOfDay dawn … dusk | night
        dwc:verbatimLocality (own locality)
        spatialContext · microhabitat · relativeElevation
        dwc:minimumElevationInMeters · dwc:maximumElevationInMeters
    }
    class TravelEvent {
        journey of the diarist
    }
    class TravelLeg {
        transportMode (when stated)
        departureTime · arrivalTime
    }
    class WeatherReport {
        weatherVerbatim
        temperatureValue · temperatureUnit
        precipitation · skyCondition · wind
    }

    class Taxon {
        <<dwc:Taxon>>
        dwc:vernacularName · dwc:scientificName
        dwc:taxonRank · isBird
        dwc:kingdom … dwc:genus
        matchMethod · gbifMatchType
        dwc:taxonID
    }
    class Place {
        <<geo:SpatialThing · dcterms:Location · gsp:Feature>>
        rdfs:label · skos:altLabel
        placeKind settlement | locality | region
        geo:lat · geo:long
        dwc:coordinateUncertaintyInMeters
        dwc:georeferenceSources
        dwc:minimumElevationInMeters · dwc:maximumElevationInMeters
    }
    class Geometry {
        <<gsp:Geometry>>
        gsp:asWKT POINT(lon lat)
    }
    class Person {
        <<schema:Person>>
        schema:name
    }
    class HabitatConcept {
        <<skos:Concept · lkg:habitatScheme>>
        skos:prefLabel · skos:altLabel
    }
    class AuthorityRecord {
        <<skos:Concept · lkg:authority_*>>
        skos:inScheme GBIF | EUNIS | GeoNames | Wikidata | GND
        skos:notation · skos:prefLabel
        skos:broader chain (EUNIS)
    }

    class ExtractionRun {
        <<prov:Activity>>
        prov:startedAtTime
    }
    class SoftwareAgent {
        <<prov:SoftwareAgent>>
        model · backend
    }
    class Prompt {
        <<prov:Entity>>
        sha256
    }

    ArchivalUnit <|-- DiaryVolume
    ArchivalUnit <|-- DiaryPage
    ArchivalUnit <|-- DiaryEntry
    ArchivalUnit <|-- SourceRegion
    SourceRegion <|-- MultimodalRegion
    EntryRecord <|-- Observation
    EntryRecord <|-- TravelEvent
    EntryRecord <|-- TravelLeg
    EntryRecord <|-- WeatherReport

    DiaryPage --> "1" DiaryVolume : dcterms∶isPartOf
    DiaryEntry --> "1" DiaryPage : dcterms∶isPartOf
    SourceRegion --> "0..1" DiaryPage : dcterms∶isPartOf
    DiaryEntry --> "*" SourceRegion : hasSourceRegion
    DiaryEntry --> "*" MultimodalRegion : hasMultimodalRegion ⊑ hasSourceRegion
    DiaryEntry --> "0..1" Place : entryPlace
    DiaryEntry --> "*" Observation : containsObservation ⊑ dcterms∶hasPart
    DiaryEntry --> "*" TravelEvent : containsTravelEvent ⊑ dcterms∶hasPart
    DiaryEntry --> "0..1" WeatherReport : hasWeather ⊑ dcterms∶hasPart
    DiaryEntry --> "*" Person : mentionsPerson · mentionsCompanion | Source | Collector | CitedAuthor | Other

    Observation --> "1" Taxon : observedTaxon ⊑ dwciri∶toTaxon
    Observation --> "0..1" Place : observedAt
    Observation --> "0..1" Place : hasLocality (own place)
    Observation --> "*" Person : dwciri∶recordedBy (diarist + co-observers, or third-party observer)
    Observation --> "0..1" HabitatConcept : dwciri∶habitat
    Observation --> "1" ExtractionRun : prov∶wasGeneratedBy

    TravelEvent --> "1..*" TravelLeg : hasLeg ⊑ dcterms∶hasPart
    TravelLeg --> "1..*" Place : arrivalPlace · departurePlace (0..1) · viaPlace
    ExtractionRun --> "1" SoftwareAgent : prov∶wasAssociatedWith
    ExtractionRun --> "1" Prompt : prov∶used

    Place --> "0..1" Geometry : gsp∶hasGeometry
    Taxon --> "0..1" AuthorityRecord : skos∶exactMatch | closeMatch | broadMatch (GBIF)
    HabitatConcept --> "0..1" AuthorityRecord : skos∶exactMatch | closeMatch | broadMatch (EUNIS)
    Place --> "0..2" AuthorityRecord : skos∶exactMatch | closeMatch (GeoNames, Wikidata)
    Person --> "0..2" AuthorityRecord : skos∶exactMatch | closeMatch (Wikidata, GND)

    cssClass "ArchivalUnit,EntryRecord" abstract
    cssClass "DiaryVolume,DiaryPage,SourceRegion,MultimodalRegion" source
    cssClass "DiaryEntry,Observation" hub
    cssClass "TravelEvent,TravelLeg,WeatherReport,Geometry" detail
    cssClass "Taxon,Place,Person" entity
    cssClass "HabitatConcept" concept
    cssClass "ExtractionRun,SoftwareAgent,Prompt" prov
    cssClass "AuthorityRecord" ext
    classDef abstract fill:#FBFBF9,stroke:#7E8C82,stroke-width:1px,stroke-dasharray:3 3,color:#5F6E64,font-style:italic
    classDef hub fill:#DDEBDF,stroke:#2F6B45,stroke-width:3px,color:#14261B
    classDef entity fill:#E2EBF5,stroke:#35608A,stroke-width:2px,color:#14263A
    classDef detail fill:#F7F8F4,stroke:#7E8C82,stroke-width:1px,color:#1D2A21
    classDef concept fill:#F3EEF7,stroke:#6E5A8A,stroke-width:1px,color:#2E2340
    classDef source fill:#F1ECE0,stroke:#8A7A5A,stroke-width:1px,color:#3A3020
    classDef prov fill:#EEEFEC,stroke:#8A8F8B,stroke-width:1px,stroke-dasharray:5 4,color:#3B413D
    classDef ext fill:#FFFFFF,stroke:#35608A,stroke-width:1px,stroke-dasharray:6 4,color:#14263A
