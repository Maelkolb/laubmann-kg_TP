%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#F7F8F4", "primaryBorderColor": "#7E8C82", "primaryTextColor": "#1D2A21", "lineColor": "#5F6E64", "clusterBkg": "#EEF1EA", "clusterBorder": "#C9D2C7", "fontFamily": "Segoe UI, system-ui, sans-serif", "fontSize": "14px"}}}%%
classDiagram
    direction TB

    class DiaryVolume {
        <<rico:Record>>
    }
    class DiaryPage {
        <<rico:Record>>
        dcterms:identifier
    }
    class DiaryEntry {
        <<rico:Record · dwc:Event>>
        entryDate · entryDateEnd
        entryKind
        dwc:eventDate · dwc:verbatimEventDate
        dateNote · datePlausible
        rawText
    }

    class ObservationEvent {
        <<dwc:Occurrence>>
        verbatimNotes
        recordType field | third-party | literature
        dwc:occurrenceStatus present | absent
        individualCount ≥0 · Min · Max
        countQualifier
        dwc:sex · dwc:lifeStage · dwc:vitality
        breedingEvidence · movementKind · flightDirection
        dwc:identificationQualifier
        dwc:eventDate · dwc:eventTime
        dwc:basisOfRecord
    }
    class ObservationEvidence {
        visual | auditory | nest | specimen
    }
    class BirdCall {
        callType
        callTranscription
    }
    class BehaviourNote {
        rdfs:label
    }

    class Taxon {
        <<dwc:Taxon>>
        vernacularNameDE · scientificName
        dwc:taxonRank · isBird
        matchMethod · matchConfidence
        dwc:taxonID
    }
    class Place {
        <<geo:SpatialThing · dcterms:Location>>
        rdfs:label · verbatimLocality
        placeKind
        geo:lat · geo:long
    }
    class Person {
        <<schema:Person>>
        schema:name · role
    }
    class Habitat {
        <<skos:Concept>>
        skos:prefLabel · dwc:habitat
    }

    class TravelEvent {
        <<dwc:Event>>
    }
    class TravelLeg {
        transportMode
        departureTime · arrivalTime
    }
    class WeatherReport {
        weatherVerbatim
        temperatureValue · temperatureUnit
        precipitation · skyCondition · wind
    }

    class ExtractionRun {
        <<prov:Activity>>
        prov:startedAtTime
    }
    class SoftwareAgent {
        <<prov:SoftwareAgent>>
        model
    }
    class Prompt {
        <<prov:Entity>>
        sha256
    }

    class GBIF_Species {
        gbif.org/species/KEY
    }
    class Wikidata_Item {
        wikidata.org/entity/Q…
    }

    DiaryEntry --> "1" DiaryVolume : hasVolume
    DiaryEntry --> "0..1" DiaryPage : hasPage
    DiaryEntry --> "0..1" Place : entryPlace
    DiaryEntry --> "*" ObservationEvent : containsObservation
    DiaryEntry --> "*" TravelEvent : containsTravelEvent
    DiaryEntry --> "*" Person : mentionsPerson ⊑ schema∶mentions
    DiaryEntry --> "0..1" WeatherReport : hasWeather

    ObservationEvent --> "1" Taxon : observedTaxon ⊑ dwciri∶toTaxon
    ObservationEvent --> "0..1" Place : observedAt
    ObservationEvent --> "0..1" Place : hasLocality (own place)
    ObservationEvent --> "0..1" Person : observedBy ⊑ dwciri∶recordedBy
    ObservationEvent --> "0..4" ObservationEvidence : hasEvidence
    ObservationEvent --> "*" BehaviourNote : hasBehaviour
    ObservationEvent --> "0..1" Habitat : hasHabitat ⊑ dwciri∶habitat
    ObservationEvent --> "1" ExtractionRun : prov∶wasGeneratedBy
    BirdCall --|> ObservationEvidence

    TravelEvent --> "1..*" TravelLeg : hasLeg
    TravelLeg --> "1..*" Place : departurePlace · arrivalPlace · viaPlace
    ExtractionRun --> "1" SoftwareAgent : prov∶wasAssociatedWith
    ExtractionRun --> "1" Prompt : prov∶used

    Taxon --> "0..1" GBIF_Species : skos∶exactMatch · closeMatch · broadMatch
    Person --> "0..1" Wikidata_Item : owl∶sameAs

    cssClass "DiaryVolume,DiaryPage" source
    cssClass "DiaryEntry,ObservationEvent" hub
    cssClass "ObservationEvidence,BirdCall,BehaviourNote,Habitat,TravelEvent,TravelLeg,WeatherReport" detail
    cssClass "Taxon,Place,Person" entity
    cssClass "ExtractionRun,SoftwareAgent,Prompt" prov
    cssClass "GBIF_Species,Wikidata_Item" ext
    classDef hub fill:#DDEBDF,stroke:#2F6B45,stroke-width:3px,color:#14261B
    classDef entity fill:#E2EBF5,stroke:#35608A,stroke-width:2px,color:#14263A
    classDef detail fill:#F7F8F4,stroke:#7E8C82,stroke-width:1px,color:#1D2A21
    classDef source fill:#F1ECE0,stroke:#8A7A5A,stroke-width:1px,color:#3A3020
    classDef prov fill:#EEEFEC,stroke:#8A8F8B,stroke-width:1px,stroke-dasharray:5 4,color:#3B413D
    classDef ext fill:#FFFFFF,stroke:#35608A,stroke-width:1px,stroke-dasharray:6 4,color:#14263A
