# =============================================================
# HistOrniGraph / Laubmann Knowledge Graph
# SHACL Validation Shapes  –  ontologies/shacl_shapes.ttl
# Validates instance data against ontologies/laubmann.ttl (v0.3.0)
#
# v0.3 – Neue Property-Shapes für die LLM-extrahierten Details
#        (occurrenceStatus, sex, lifeStage, breedingEvidence, movementKind,
#        individualCountMin/Max, eventDate/eventTime, hasLocality,
#        entryPlace/entryKind/entryDateEnd, placeKind, taxonRank, isBird,
#        evidenceKind). dwc:occurrenceStatus sitzt jetzt auf dem
#        ObservationEvent (nicht mehr auf der Evidenz). callTranscription ist
#        optional (kein Platzhalter mehr). Habitat ist ein skos:Concept und
#        KEIN Place mehr (eigene HabitatShape). individualCount erlaubt 0
#        (explizite Abwesenheit).
# v0.2 – Fix: sh:datatype xsd:string schlug fehl für alle
#        sprachmarkierten Literale ("..."@de), da diese in RDF
#        den Datentyp rdf:langString (nicht xsd:string) haben.
#        Fix via sh:or (xsd:string | rdf:langString).
#
# Usage:
#   python -m laubmann_kg.kg.shacl_validate --data <data>.ttl
#   (entspricht pyshacl -s ontologies/shacl_shapes.ttl -d <data>.ttl -f human)
#   Es wird OHNE Inferenz validiert: der Emitter (kg/rdf.py) materialisiert
#   alle Superklassen, auf die Shapes angewiesen sind (BirdCall →
#   ObservationEvidence, Habitat → skos:Concept, SourceRegion → oa:Annotation).
#   Alle sh:in-Werte spiegeln src/laubmann_kg/normalization/vocabularies.py
#   und ontologies/controlled_vocabularies.ttl.
#
# Severity-Politik: Warning für Vokabular-/Vollständigkeits-Hinweise;
#   Violation für Datentyp-/Kardinalitätsfehler, die auf Emitter-Bugs deuten.
# =============================================================

@prefix lkg:     <https://w3id.org/laubmann-kg/ontology#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dwc:     <http://rs.tdwg.org/dwc/terms/> .
@prefix dwciri:  <http://rs.tdwg.org/dwc/iri/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rico:    <https://www.ica.org/standards/RiC/ontology#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .

# -------------------------------------------------------------
# Shapes graph declaration (also lets pyLODE/valpub document it)
# -------------------------------------------------------------
<https://w3id.org/laubmann-kg/shapes>
    a owl:Ontology , sh:ShapesGraph ;
    dcterms:title "Laubmann Knowledge Graph — SHACL shapes"@en ;
    dcterms:description "Validation shapes for the Laubmann KG data graph (https://w3id.org/laubmann-kg/ontology). Run with inference=none: every superclass a shape relies on is materialised by the emitter. Vocabulary/completeness checks are sh:Warning, datatype and cardinality checks sh:Violation."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-18"^^xsd:date ;
    owl:versionInfo "0.3.0" ;
    rdfs:seeAlso <https://w3id.org/laubmann-kg/ontology> .


# =============================================================
# WIEDERVERWENDBARE HILFS-KONSTRUKTE
# =============================================================
# Hinweis: SHACL kennt keine "Makros"/Funktionen; das folgende
# sh:or-Pattern muss bei jeder mehrsprachigen String-Property
# wiederholt werden. Alternative: alle Literale konsequent OHNE
# Sprachtag anlegen (dann reicht sh:datatype xsd:string).

# =============================================================
# 1. DIARY VOLUME / PAGE
# =============================================================

lkg:DiaryVolumeShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryVolume ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Jeder DiaryVolume benötigt ein rdfs:label (z. B. Bandnummer)." ;
        sh:severity sh:Violation ;
    ] .

lkg:DiaryPageShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryPage ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Jede DiaryPage benötigt ein rdfs:label (z. B. Seitennummer)." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 2. DIARY ENTRY
# =============================================================

lkg:DiaryEntryShape
    a sh:NodeShape ;
    sh:targetClass lkg:DiaryEntry ;

    sh:property [
        sh:path lkg:entryDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "DiaryEntry muss genau ein entryDate (xsd:date) besitzen." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path lkg:rawText ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "DiaryEntry sollte den transkribierten Rohtext (lkg:rawText) enthalten." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:hasVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryVolume ;
        sh:message "DiaryEntry sollte genau einem DiaryVolume zugeordnet sein (Ziel-Knoten muss rdf:type lkg:DiaryVolume haben!)." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:hasWeather ;
        sh:maxCount 1 ;
        sh:class lkg:WeatherReport ;
        sh:message "DiaryEntry darf höchstens einen WeatherReport haben." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:entryPlace ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "entryPlace muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:entryKind ;
        sh:maxCount 1 ;
        sh:in ( "field-day" "species-digest" "retrospective" "correspondence" "other" ) ;
        sh:message "entryKind muss field-day, species-digest, retrospective, correspondence oder other sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:entryDateEnd ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "entryDateEnd muss höchstens ein xsd:date sein (nur mehrtägige Einträge)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:eventDate ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:eventDate pro DiaryEntry (xsd:date oder ISO-Intervall start/end)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:datePlausible ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "datePlausible muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dcterms:identifier (entry_id) pro DiaryEntry." ;
        sh:severity sh:Warning ;
    ] ;

    sh:or (
        [ sh:path lkg:containsObservation ; sh:minCount 1 ]
        [ sh:path lkg:containsTravelEvent ; sh:minCount 1 ]
        [ sh:path lkg:hasWeather ; sh:minCount 1 ]
    ) ;
    sh:message "DiaryEntry sollte mindestens eine Observation, ein TravelEvent oder einen WeatherReport enthalten – sonst vermutlich Segmentierungsfehler." ;
    sh:severity sh:Warning .

# =============================================================
# 3. SOURCE REGION
# =============================================================

lkg:SourceRegionShape
    a sh:NodeShape ;
    sh:targetClass lkg:SourceRegion ;
    sh:node [
        a sh:NodeShape ;
        sh:class oa:Annotation ;
    ] ;
    sh:message "SourceRegion muss eine gültige oa:Annotation-Struktur besitzen (Provenienz zum Scan)." .

# =============================================================
# 4. OBSERVATION EVENT
# =============================================================

lkg:ObservationEventShape
    a sh:NodeShape ;
    sh:targetClass lkg:ObservationEvent ;

    sh:property [
        sh:path lkg:observedTaxon ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Taxon ;
        sh:message "ObservationEvent MUSS genau einen lkg:observedTaxon referenzieren." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path lkg:derivedFromEntry ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:DiaryEntry ;
        sh:message "ObservationEvent MUSS über lkg:derivedFromEntry auf seinen DiaryEntry zurückverweisen (verhindert Orphan Nodes)." ;
        sh:severity sh:Violation ;
    ] ;

    # FIX: sh:or statt reinem sh:datatype xsd:string
    sh:property [
        sh:path lkg:verbatimNotes ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "ObservationEvent sollte den originalen Diariumstext (lkg:verbatimNotes) enthalten." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:observedAt ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "ObservationEvent sollte einen Ort (lkg:observedAt) referenzieren – Ziel-Knoten benötigt rdf:type lkg:Place." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:hasLocality ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "hasLocality (eigene Örtlichkeit des Nachweises) muss auf höchstens einen lkg:Place zeigen." ;
        sh:severity sh:Warning ;
    ] ;

    # Evidenz nur, wenn der Text sagt WIE beobachtet wurde: kein minCount.
    # Max. 4 = visual + auditory + nest + specimen. Subklasse BirdCall wird
    # vom Emitter zusätzlich als ObservationEvidence typisiert.
    sh:property [
        sh:path lkg:hasEvidence ;
        sh:maxCount 4 ;
        sh:class lkg:ObservationEvidence ;
        sh:message "hasEvidence: höchstens 4 Evidenzknoten (visual/auditory/nest/specimen), jeweils rdf:type lkg:ObservationEvidence." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:hasHabitat ;
        sh:maxCount 1 ;
        sh:class lkg:Habitat ;
        sh:message "hasHabitat muss auf höchstens einen lkg:Habitat zeigen." ;
        sh:severity sh:Warning ;
    ] ;

    # 0 nur bei expliziter Abwesenheit (dwc:occurrenceStatus "absent")
    sh:property [
        sh:path lkg:individualCount ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCount muss eine Ganzzahl >= 0 sein (0 nur bei occurrenceStatus absent)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMin ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMin muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:individualCountMax ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "lkg:individualCountMax muss eine Ganzzahl >= 0 sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:countQualifier ;
        sh:maxCount 1 ;
        sh:in ( "exact" "minimum" "approximate" "plural-unspecified" ) ;
        sh:message "countQualifier muss exact, minimum, approximate oder plural-unspecified sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:occurrenceStatus ;
        sh:maxCount 1 ;
        sh:in ( "present" "absent" ) ;
        sh:message "dwc:occurrenceStatus (auf dem ObservationEvent) muss present oder absent sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:sex ;
        sh:maxCount 1 ;
        sh:in ( "male" "female" "mixed" ) ;
        sh:message "dwc:sex muss male, female oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:lifeStage ;
        sh:maxCount 1 ;
        sh:in ( "adult" "juvenile" "pullus" "immature" "egg" "mixed" ) ;
        sh:message "dwc:lifeStage muss adult, juvenile, pullus, immature, egg oder mixed sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:vitality ;
        sh:maxCount 1 ;
        sh:in ( "alive" "dead" ) ;
        sh:message "dwc:vitality muss alive oder dead sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:breedingEvidence ;
        sh:maxCount 1 ;
        sh:in ( "confirmed" "probable" "possible" ) ;
        sh:message "breedingEvidence muss confirmed, probable oder possible sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:movementKind ;
        sh:maxCount 1 ;
        sh:in ( "migrating" "passing-over" "arriving" "departing" "resting" "roosting" ) ;
        sh:message "movementKind muss migrating, passing-over, arriving, departing, resting oder roosting sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:flightDirection ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "flightDirection: höchstens ein Literal (wie geschrieben)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:identificationQualifier ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:identificationQualifier." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path dwc:eventDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:message "dwc:eventDate auf dem ObservationEvent muss genau ein xsd:date sein (eigenes Datum oder Eintragsdatum)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:eventTime ;
        sh:maxCount 1 ;
        sh:pattern "^[0-9]{2}:[0-9]{2}$" ;
        sh:message "dwc:eventTime muss höchstens einmal vorkommen und HH:MM sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:property [
        sh:path lkg:recordType ;
        sh:maxCount 1 ;
        sh:in ( "field-observation" "third-party-report" "literature-record" ) ;
        sh:message "recordType muss field-observation, third-party-report oder literature-record sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:observedBy ;
        sh:maxCount 1 ;
        sh:class lkg:Person ;
        sh:message "observedBy muss auf höchstens eine lkg:Person zeigen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:basisOfRecord ;
        sh:maxCount 1 ;
        sh:in ( "HumanObservation" "PreservedSpecimen" "MaterialCitation" ) ;
        sh:message "basisOfRecord muss HumanObservation, PreservedSpecimen oder MaterialCitation sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:maxCount 1 ;
        sh:class prov:Activity ;
        sh:message "prov:wasGeneratedBy muss auf höchstens eine prov:Activity (Extraktionslauf) zeigen." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 5. TRAVEL EVENT / LEG
# =============================================================

lkg:TravelEventShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelEvent ;
    sh:property [
        sh:path lkg:hasLeg ;
        sh:minCount 1 ;
        sh:class lkg:TravelLeg ;
        sh:message "TravelEvent MUSS mindestens einen TravelLeg (lkg:hasLeg) besitzen." ;
        sh:severity sh:Violation ;
    ] .

lkg:TravelLegShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelLeg ;

    sh:property [
        sh:path lkg:departurePlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg MUSS genau einen Abfahrtsort (lkg:departurePlace) haben." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path lkg:arrivalPlace ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class lkg:Place ;
        sh:message "TravelLeg MUSS genau einen Ankunftsort (lkg:arrivalPlace) haben." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path lkg:transportMode ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "train" "foot" "boat" "car" "carriage" "bicycle" "unknown" ) ;
        sh:message "TravelLeg sollte ein bekanntes transportMode-Vokabular verwenden." ;
        sh:severity sh:Warning ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "arrivalTime muss zeitlich nach departureTime liegen." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this lkg:departureTime ?dep .
                $this lkg:arrivalTime ?arr .
                FILTER (?arr <= ?dep)
            }
        """ ;
    ] .

# =============================================================
# 6. PLACE / HABITAT / ROUTE
# =============================================================

lkg:PlaceShape
    a sh:NodeShape ;
    sh:targetClass lkg:Place ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Place benötigt ein rdfs:label (Ortsname)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path geo:lat ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "geo:lat muss zwischen -90 und 90 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path geo:long ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "geo:long muss zwischen -180 und 180 liegen." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLatitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:message "dwc:decimalLatitude muss xsd:decimal in [-90, 90] sein (Kopie von geo:lat)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path dwc:decimalLongitude ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:message "dwc:decimalLongitude muss xsd:decimal in [-180, 180] sein (Kopie von geo:long)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:placeKind ;
        sh:maxCount 1 ;
        sh:in ( "settlement" "locality" "region" "route" "unknown" ) ;
        sh:message "placeKind muss settlement, locality, region, route oder unknown sein." ;
        sh:severity sh:Warning ;
    ] .

# Habitat ist ein skos:Concept (kein Place): eigene Label-Pflicht.
lkg:HabitatShape
    a sh:NodeShape ;
    sh:targetClass lkg:Habitat ;
    sh:or (
        [ sh:path skos:prefLabel ; sh:minCount 1 ]
        [ sh:path rdfs:label ; sh:minCount 1 ]
    ) ;
    sh:message "Habitat benötigt skos:prefLabel oder rdfs:label." ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path dwc:habitat ;
        sh:minCount 1 ;
        sh:message "Habitat sollte dwc:habitat-Beschreibung enthalten." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:maxCount 1 ;
        sh:hasValue lkg:habitatScheme ;
        sh:message "Habitat sollte skos:inScheme lkg:habitatScheme tragen." ;
        sh:severity sh:Warning ;
    ] .

lkg:RouteShape
    a sh:NodeShape ;
    sh:targetClass lkg:Route ;
    sh:property [
        sh:path lkg:routePoint ;
        sh:minCount 2 ;
        sh:class lkg:Place ;
        sh:message "Route sollte mind. 2 routePoints besitzen (sonst keine sinnvolle Route)." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 7. TAXON
# =============================================================

lkg:TaxonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Taxon ;

    # FIX (Root Cause A): sh:or statt reinem sh:datatype xsd:string.
    # "Kiebitz"@de hat den RDF-Datentyp rdf:langString, NICHT
    # xsd:string – daher schlug die alte Regel für JEDEN Taxon
    # mit Sprachtag fehl (6 von 6 Violations im Report).
    sh:property [
        sh:path lkg:vernacularNameDE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "Taxon MUSS einen deutschen Vernacular-Namen (lkg:vernacularNameDE) haben – auch bei unbestimmter Art." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path skos:exactMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:exactMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:closeMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:closeMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path skos:broadMatch ;
        sh:nodeKind sh:IRI ;
        sh:message "skos:broadMatch muss eine IRI sein (GBIF-Backbone-Link)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:taxonID ;
        sh:maxCount 1 ;
        sh:message "Höchstens ein dwc:taxonID pro Taxon." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path dwc:taxonRank ;
        sh:maxCount 1 ;
        sh:in ( "species" "subspecies" "genus" "family" "group" "unknown" ) ;
        sh:message "dwc:taxonRank muss species, subspecies, genus, family, group oder unknown sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:isBird ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "lkg:isBird muss höchstens ein xsd:boolean sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:matchConfidence ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "lkg:matchConfidence muss xsd:decimal in [0, 1] sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:gbifMatchType ;
        sh:maxCount 1 ;
        sh:in ( "EXACT" "FUZZY" "HIGHERRANK" ) ;
        sh:message "lkg:gbifMatchType muss EXACT, FUZZY oder HIGHERRANK sein." ;
        sh:severity sh:Warning ;
    ] ;

    sh:or (
        [ sh:path lkg:scientificName ; sh:minCount 1 ]
        [ sh:path skos:note ; sh:minCount 1 ]
    ) ;
    sh:message "Taxon sollte entweder scientificName ODER eine skos:note zur Unsicherheit haben." ;
    sh:severity sh:Warning .

# =============================================================
# 8. OBSERVATION EVIDENCE / BIRDCALL / BEHAVIOUR
# =============================================================

lkg:ObservationEvidenceShape
    a sh:NodeShape ;
    sh:targetClass lkg:ObservationEvidence ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "ObservationEvidence sollte ein beschreibendes rdfs:label haben." ;
        sh:severity sh:Warning ;
    ] ;
    # Die Konzept-IRIs leben in controlled_vocabularies.ttl (nicht im
    # Datengraph geladen) → sh:in statt sh:class skos:Concept.
    sh:property [
        sh:path lkg:evidenceKind ;
        sh:maxCount 1 ;
        sh:in ( lkg:evidence_visual lkg:evidence_auditory lkg:evidence_nest lkg:evidence_specimen ) ;
        sh:message "evidenceKind muss lkg:evidence_visual, _auditory, _nest oder _specimen sein." ;
        sh:severity sh:Warning ;
    ] ;
    # dwc:occurrenceStatus gehört auf das ObservationEvent, nicht auf den Beleg.
    sh:property [
        sh:path dwc:occurrenceStatus ;
        sh:maxCount 0 ;
        sh:message "dwc:occurrenceStatus sitzt auf dem ObservationEvent, nicht auf der Evidenz (Altbestand)." ;
        sh:severity sh:Warning ;
    ] .

lkg:BirdCallShape
    a sh:NodeShape ;
    sh:targetClass lkg:BirdCall ;
    # Lautschrift nur, wenn das Tagebuch eine nennt (kein "Ruf"-Platzhalter).
    sh:property [
        sh:path lkg:callTranscription ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "BirdCall darf höchstens eine callTranscription (Lautschrift) enthalten." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:callType ;
        sh:maxCount 1 ;
        sh:in ( "song" "call" "alarm" "drumming" "unknown" ) ;
        sh:message "callType sollte bekanntes Vokabular verwenden." ;
        sh:severity sh:Warning ;
    ] .

lkg:BehaviourNoteShape
    a sh:NodeShape ;
    sh:targetClass lkg:BehaviourNote ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "BehaviourNote sollte ein beschreibendes rdfs:label haben." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 8b. WEATHER REPORT
# =============================================================

lkg:WeatherReportShape
    a sh:NodeShape ;
    sh:targetClass lkg:WeatherReport ;
    sh:property [
        sh:path lkg:weatherVerbatim ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "WeatherReport MUSS genau ein weatherVerbatim tragen (Verbatim ist primär)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path lkg:temperatureValue ;
        sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:minInclusive -76 ; sh:maxInclusive 140 ;
        sh:message "temperatureValue muss xsd:decimal in [-76, 140] sein (plausibler Bereich hängt von der Einheit ab: F erlaubt bis 140, C/R bis 60)." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:temperatureUnit ;
        sh:maxCount 1 ;
        sh:in ( "C" "R" "F" ) ;
        sh:message "temperatureUnit muss C, R oder F sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:precipitation ;
        sh:maxCount 1 ;
        sh:in ( "rain" "snow" "sleet" "hail" "drizzle" "fog" "thunderstorm" "none" ) ;
        sh:message "precipitation muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:skyCondition ;
        sh:maxCount 1 ;
        sh:in ( "clear" "partly-cloudy" "overcast" "variable" ) ;
        sh:message "skyCondition muss aus dem kontrollierten Vokabular stammen." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path lkg:wind ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
        sh:message "wind sollte höchstens ein Literal sein." ;
        sh:severity sh:Warning ;
    ] .

lkg:NoOrphanWeatherShape
    a sh:NodeShape ;
    sh:targetClass lkg:WeatherReport ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "WeatherReport hängt an keinem DiaryEntry (kein lkg:hasWeather verweist auf ihn)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this a lkg:WeatherReport .
                FILTER NOT EXISTS { ?entry lkg:hasWeather $this }
            }
        """ ;
    ] .

# =============================================================
# 9. TIME ESTIMATE
# =============================================================

lkg:TimeEstimateShape
    a sh:NodeShape ;
    sh:targetClass lkg:TimeEstimate ;

    sh:property [
        sh:path time:hasBeginning ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimeEstimate MUSS time:hasBeginning besitzen." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path time:hasEnd ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "TimeEstimate MUSS time:hasEnd besitzen." ;
        sh:severity sh:Violation ;
    ] ;

    sh:property [
        sh:path skos:note ;
        sh:minCount 1 ;
        sh:message "TimeEstimate sollte eine skos:note mit der Ableitungslogik enthalten (Nachvollziehbarkeit der Schätzung)." ;
        sh:severity sh:Warning ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "time:hasEnd muss zeitlich nach time:hasBeginning liegen." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX time: <http://www.w3.org/2006/time#>
            SELECT $this WHERE {
                $this time:hasBeginning ?b .
                $this time:hasEnd ?e .
                FILTER (?e <= ?b)
            }
        """ ;
    ] .

# =============================================================
# 10. PERSON
# =============================================================

lkg:PersonShape
    a sh:NodeShape ;
    sh:targetClass lkg:Person ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "Person benötigt ein rdfs:label (Name)." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path owl:sameAs ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "owl:sameAs (Wikidata) muss eine IRI sein, höchstens eine." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 10b. PROV: EXTRAKTIONSLAUF
# =============================================================

lkg:ExtractionRunShape
    a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:property [
        sh:path prov:startedAtTime ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "prov:startedAtTime muss höchstens ein xsd:dateTime sein." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path prov:wasAssociatedWith ;
        sh:minCount 1 ;
        sh:class prov:SoftwareAgent ;
        sh:message "Der Extraktionslauf sollte einem prov:SoftwareAgent (Modell) zugeordnet sein." ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        sh:path prov:used ;
        sh:class prov:Entity ;
        sh:message "prov:used muss auf prov:Entity-Knoten (Prompt) zeigen." ;
        sh:severity sh:Warning ;
    ] .

# =============================================================
# 11. ORPHAN-NODE-PRÜFUNG
# =============================================================

lkg:NoOrphanObservationShape
    a sh:NodeShape ;
    sh:targetClass lkg:ObservationEvent ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ObservationEvent ist nicht über containsObservation mit einem DiaryEntry verlinkt (Orphan Node)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this a lkg:ObservationEvent .
                FILTER NOT EXISTS { ?entry lkg:containsObservation $this }
            }
        """ ;
    ] .

lkg:NoOrphanTravelLegShape
    a sh:NodeShape ;
    sh:targetClass lkg:TravelLeg ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "TravelLeg ist keinem TravelEvent über hasLeg zugeordnet (Orphan Node)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX lkg: <https://w3id.org/laubmann-kg/ontology#>
            SELECT $this WHERE {
                $this a lkg:TravelLeg .
                FILTER NOT EXISTS { ?event lkg:hasLeg $this }
            }
        """ ;
    ] .