# =============================================================
# HistOrniGraph / Laubmann Knowledge Graph
# Controlled Vocabularies (SKOS)
# Mirrors the sh:in enumerations in shacl_shapes.ttl so extraction
# and validation share one source of truth.
# =============================================================

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix lkg:  <https://lkg.example.org/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# --- Transport modes (TravelLeg.transportMode) ---------------
lkg:transportModeScheme a skos:ConceptScheme ;
    skos:prefLabel "Transport modes"@en .

lkg:transport_train   a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "train"@en, "Zug"@de .
lkg:transport_foot    a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "foot"@en, "zu Fuß"@de .
lkg:transport_boat    a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "boat"@en, "Boot"@de .
lkg:transport_car     a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "car"@en, "Auto"@de .
lkg:transport_carriage a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "carriage"@en, "Kutsche"@de .
lkg:transport_bicycle a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "bicycle"@en, "Fahrrad"@de .
lkg:transport_unknown a skos:Concept ; skos:inScheme lkg:transportModeScheme ; skos:prefLabel "unknown"@en, "unbekannt"@de .

# --- Call types (BirdCall.callType) --------------------------
lkg:callTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Bird call types"@en .

lkg:call_song     a skos:Concept ; skos:inScheme lkg:callTypeScheme ; skos:prefLabel "song"@en, "Gesang"@de .
lkg:call_call     a skos:Concept ; skos:inScheme lkg:callTypeScheme ; skos:prefLabel "call"@en, "Ruf"@de .
lkg:call_alarm    a skos:Concept ; skos:inScheme lkg:callTypeScheme ; skos:prefLabel "alarm"@en, "Warnruf"@de .
lkg:call_drumming a skos:Concept ; skos:inScheme lkg:callTypeScheme ; skos:prefLabel "drumming"@en, "Trommeln"@de .
lkg:call_unknown  a skos:Concept ; skos:inScheme lkg:callTypeScheme ; skos:prefLabel "unknown"@en, "unbekannt"@de .

# --- Count qualifiers (ObservationEvent.countQualifier) ------
lkg:countQualifierScheme a skos:ConceptScheme ;
    skos:prefLabel "Count qualifiers"@en .

lkg:count_exact              a skos:Concept ; skos:inScheme lkg:countQualifierScheme ; skos:prefLabel "exact"@en .
lkg:count_minimum            a skos:Concept ; skos:inScheme lkg:countQualifierScheme ; skos:prefLabel "minimum"@en .
lkg:count_approximate        a skos:Concept ; skos:inScheme lkg:countQualifierScheme ; skos:prefLabel "approximate"@en .
lkg:count_plural_unspecified a skos:Concept ; skos:inScheme lkg:countQualifierScheme ; skos:prefLabel "plural-unspecified"@en .

# --- Evidence kinds (ObservationEvidence) --------------------
lkg:evidenceKindScheme a skos:ConceptScheme ;
    skos:prefLabel "Observation evidence kinds"@en .

lkg:evidence_visual   a skos:Concept ; skos:inScheme lkg:evidenceKindScheme ; skos:prefLabel "visual"@en, "Sichtbeobachtung"@de .
lkg:evidence_auditory a skos:Concept ; skos:inScheme lkg:evidenceKindScheme ; skos:prefLabel "auditory"@en, "Lautäußerung"@de .
lkg:evidence_nest     a skos:Concept ; skos:inScheme lkg:evidenceKindScheme ; skos:prefLabel "nest"@en, "Nestfund"@de .
lkg:evidence_specimen a skos:Concept ; skos:inScheme lkg:evidenceKindScheme ; skos:prefLabel "specimen"@en, "Beleg"@de .

# --- Record types (ObservationEvent.recordType) --------------
lkg:recordTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "Observation record types"@en .

lkg:record_field_observation  a skos:Concept ; skos:inScheme lkg:recordTypeScheme ; skos:prefLabel "field-observation"@en, "eigene Feldbeobachtung"@de .
lkg:record_third_party_report a skos:Concept ; skos:inScheme lkg:recordTypeScheme ; skos:prefLabel "third-party-report"@en, "Fremdbericht"@de .
lkg:record_literature_record  a skos:Concept ; skos:inScheme lkg:recordTypeScheme ; skos:prefLabel "literature-record"@en, "Literaturnachweis"@de .

# --- Precipitation (WeatherReport.precipitation) -------------
lkg:precipitationScheme a skos:ConceptScheme ;
    skos:prefLabel "Precipitation types"@en .

lkg:precip_rain         a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "rain"@en, "Regen"@de .
lkg:precip_snow         a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "snow"@en, "Schnee"@de .
lkg:precip_sleet        a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "sleet"@en, "Schneeregen/Graupel"@de .
lkg:precip_hail         a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "hail"@en, "Hagel"@de .
lkg:precip_drizzle      a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "drizzle"@en, "Nieselregen"@de .
lkg:precip_fog          a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "fog"@en, "Nebel"@de .
lkg:precip_thunderstorm a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "thunderstorm"@en, "Gewitter"@de .
lkg:precip_none         a skos:Concept ; skos:inScheme lkg:precipitationScheme ; skos:prefLabel "none"@en, "niederschlagsfrei"@de .

# --- Sky conditions (WeatherReport.skyCondition) -------------
lkg:skyConditionScheme a skos:ConceptScheme ;
    skos:prefLabel "Sky conditions"@en .

lkg:sky_clear         a skos:Concept ; skos:inScheme lkg:skyConditionScheme ; skos:prefLabel "clear"@en, "heiter"@de .
lkg:sky_partly_cloudy a skos:Concept ; skos:inScheme lkg:skyConditionScheme ; skos:prefLabel "partly-cloudy"@en, "wolkig"@de .
lkg:sky_overcast      a skos:Concept ; skos:inScheme lkg:skyConditionScheme ; skos:prefLabel "overcast"@en, "bedeckt/trüb"@de .
lkg:sky_variable      a skos:Concept ; skos:inScheme lkg:skyConditionScheme ; skos:prefLabel "variable"@en, "wechselnd"@de .

# --- Temperature units (WeatherReport.temperatureUnit) -------
lkg:temperatureUnitScheme a skos:ConceptScheme ;
    skos:prefLabel "Temperature units"@en .

lkg:unit_C a skos:Concept ; skos:inScheme lkg:temperatureUnitScheme ; skos:prefLabel "C"@en, "Grad Celsius"@de .
lkg:unit_R a skos:Concept ; skos:inScheme lkg:temperatureUnitScheme ; skos:prefLabel "R"@en, "Grad Réaumur"@de .
lkg:unit_F a skos:Concept ; skos:inScheme lkg:temperatureUnitScheme ; skos:prefLabel "F"@en, "Grad Fahrenheit"@de .
