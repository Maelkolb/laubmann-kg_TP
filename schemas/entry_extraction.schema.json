{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntryExtraction",
  "description": "Full structured reading of one diary entry: observations, travel events, and mentioned persons. The observation item schema is injected at load time from observation.schema.json (single source of truth). Deliberately tolerant: the model may emit a travel event either as {legs: [...]} or as a bare leg object; type-level correctness (vocabularies, time consistency, required endpoints) is enforced by the mapper, not here. Entry-level weather is one optional object (or bare verbatim string); provenance fields (record_type/observer/literature_citation) live on each observation.",
  "type": "object",
  "required": ["observations"],
  "additionalProperties": false,
  "$defs": {
    "leg": {
      "type": "object",
      "properties": {
        "departure_place": {"type": ["string", "null"]},
        "arrival_place": {"type": ["string", "null"]},
        "via_places": {"type": ["array", "string", "null"], "items": {"type": "string"}},
        "transport_mode": {"type": ["string", "null"]},
        "departure_time": {"type": ["string", "null"]},
        "arrival_time": {"type": ["string", "null"]},
        "verbatim": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "observations": {"type": "array", "items": {}},
    "travel_events": {
      "type": ["array", "null"],
      "items": {
        "anyOf": [
          {
            "type": "object",
            "required": ["legs"],
            "properties": {
              "legs": {
                "type": "array",
                "items": {"$ref": "#/$defs/leg"}
              },
              "verbatim": {"type": ["string", "null"]}
            }
          },
          {"$ref": "#/$defs/leg"}
        ]
      }
    },
    "persons": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"type": ["string", "null"]},
          "verbatim": {"type": ["string", "null"]}
        }
      }
    },
    "weather": {
      "type": ["object", "string", "null"],
      "properties": {
        "verbatim": {"type": ["string", "null"]},
        "temperature_value": {"type": ["number", "string", "null"]},
        "temperature_unit": {"type": ["string", "null"]},
        "precipitation": {"type": ["string", "null"]},
        "wind": {"type": ["string", "null"]},
        "sky": {"type": ["string", "null"]}
      }
    }
  }
}
