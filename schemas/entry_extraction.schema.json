{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntryExtraction",
  "description": "Full structured reading of one diary entry: observations, travel events, and mentioned persons. The observation item schema is injected at load time from observation.schema.json (single source of truth).",
  "type": "object",
  "required": ["observations"],
  "additionalProperties": false,
  "properties": {
    "observations": {"type": "array", "items": {}},
    "travel_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["legs"],
        "additionalProperties": false,
        "properties": {
          "legs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["arrival_place"],
              "additionalProperties": false,
              "properties": {
                "departure_place": {"type": ["string", "null"]},
                "arrival_place": {"type": "string", "minLength": 1},
                "via_places": {"type": "array", "items": {"type": "string"}},
                "transport_mode": {
                  "type": ["string", "null"],
                  "enum": ["train", "foot", "boat", "car", "carriage", "bicycle", "unknown", null]
                },
                "departure_time": {"type": ["string", "null"]},
                "arrival_time": {"type": ["string", "null"]},
                "verbatim": {"type": ["string", "null"]}
              }
            }
          },
          "verbatim": {"type": ["string", "null"]}
        }
      }
    },
    "persons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {
            "type": ["string", "null"],
            "enum": ["companion", "source", "collector", "cited-author", "other", null]
          },
          "verbatim": {"type": ["string", "null"]}
        }
      }
    }
  }
}
